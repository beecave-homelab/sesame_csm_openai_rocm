# Environment variables for sesame_csm_openai_rocm
# Copy this file to `.env` and adjust values as needed.

# Authentication for gated Hugging Face models (optional but required to auto-download models)
HF_TOKEN=

# TTS engine selection: csm (default) or dia
TTS_ENGINE=csm

# Device mapping strategy for multi-GPU (optional): auto | balanced | sequential
CSM_DEVICE_MAP=

# Caching and performance flags
ENABLE_AUDIO_CACHE=true
ENABLE_ENHANCEMENTS=true
ENABLE_VOICE_CLONING=true

# App runtime settings
PORT=8000
DEV_MODE=false
LOG_LEVEL=INFO

# ROCm/AMD related (aligns with Dockerfile defaults)
ROCM_PATH=/opt/rocm
HSA_OVERRIDE_GFX_VERSION=10.3.0

# Advanced performance/experimental toggles (mostly effective on NVIDIA/CUDA,
# included for completeness; typically ignored on pure ROCm setups)
ENABLE_TF32=true
ENABLE_FLASH_ATTN=true
ENABLE_QUANTIZATION=false
OFFLOAD_TO_CPU=false
TORCH_COMPILE_MODE=none   # none | default | reduce-overhead | max-autotune
USE_CUDA_GRAPHS=false
